#!/bin/sh
# claudito pre-commit 비밀정보 게이트
# --------------------------------------------------------------------------
# 2026-07-30: 평문 비밀번호(CLAUDITO_PASSWORD)가 든 ecosystem.config.js 가
# .gitignore 에 추가됐는데도 이미 추적 중이라 그대로 커밋될 상태였다.
# .gitignore 는 "이미 추적 중인 파일"을 막지 못하므로 여기서 한 번 더 막는다.
#
# 우회(긴급): git commit --no-verify  (지양 — 대신 git rm --cached 하라)

blocked=""

# --diff-filter=ACMR: 추가/수정/이름변경만 본다.
# 삭제(D)까지 잡으면 `git rm --cached ecosystem.config.js` (추적 해제 = 우리가 원하는
# 바로 그 동작) 를 커밋하는 것조차 막혀버린다.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

for f in ecosystem.config.js .env docs/claudito-접속-가이드.md; do
  if echo "$staged" | grep -qx "$f"; then
    blocked="$blocked $f"
  fi
done

if [ -n "$blocked" ]; then
  echo ""
  echo "[pre-commit] 비밀정보 파일이 staged 되어 있다:$blocked"
  echo "             평문 자격증명 또는 내부 접속정보를 담고 있어 커밋하면 안 된다."
  echo "             (origin 은 공개 저장소다)"
  echo ""
  echo "  해결:  git restore --staged$blocked"
  echo "         (한 번도 추적된 적 없어야 한다 → git rm --cached <file>)"
  echo ""
  echo "  공유용 템플릿은 ecosystem.config.example.js 를 수정하라."
  echo ""
  exit 1
fi

# 인스턴스 구성 불변식(포트/홈 중복, 기존 홈 유실, placeholder 비밀번호 등)을
# 커밋 시점에 검사한다. 빌드/스모크는 pre-push 에서 하므로 여기선 구성만.
if git diff --cached --name-only | grep -qE '^(ecosystem\.config\.example\.js|scripts/validate\.mjs|\.gitignore)$'; then
  echo "[pre-commit] 멀티 인스턴스 구성 검증..."
  if ! node scripts/validate.mjs --instances; then
    echo ""
    echo "[pre-commit] 인스턴스 구성 검증 실패 — commit 차단됨."
    exit 1
  fi
fi

exit 0
